{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ESNext"], "types": ["@cloudflare/workers-types", "node"],
    "strict": true, "noEmit": true, "exactOptionalPropertyTypes": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
